{
  "version": "1.0",
  "appName": "quipapps",
  "plan": "custom",
  "runtime": "Node.js",
  "runtimeVersion": "22",
  "installCommand": "corepack enable && yarn install --immutable",
  "buildCommand": "yarn build:www",
  "runCommand": "fuser -k 80/tcp; sleep 1; if [ -x node_modules/.bin/serve ]; then exec node_modules/.bin/serve -s packages/apps/build -l tcp://0.0.0.0:80; else exec npx -y serve -s packages/apps/build -l tcp://0.0.0.0:80; fi",
  "outputDir": "packages/apps/build",
  "appPort": 80,
  "envVars": [
    { "key": "QUIP_DEV_SIGNER", "value": "1" },
    { "key": "WS_URL", "value": "wss://bootnode-1.aglais.quip.network:20049/rpc" },
    { "key": "BUILD_TIMEOUT", "value": "5400" },
    { "key": "NO_UPDATE_CHECK", "value": "1" }
  ],
  "instances": 3,
  "cpu": 2,
  "ram": 8192,
  "hdd": 5,
  "pollingInterval": "disabled",
  "autoDeploy": false
}
